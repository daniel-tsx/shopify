    "db:validate": "prisma validate",
    "worker": "tsx scripts/worker.ts",
    "demo:seed": "tsx scripts/demo.ts seed",
    "demo:sync": "tsx scripts/demo.ts sync",
    "demo:webhook": "tsx scripts/demo.ts webhook",
    "demo:throttle": "tsx scripts/demo.ts throttle"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "@react-router/dev": "7.18.2",
    "@react-router/fs-routes": "7.18.2",
    "@react-router/node": "7.18.2",
    "@react-router/serve": "7.18.2",
    "@shopify/app-bridge-react": "^4.2.4",
    "@shopify/shopify-api": "15.0.0",
    "@shopify/shopify-app-react-router": "3.0.0",
    "@shopify/shopify-app-session-storage-prisma": "^11.0.0",
    "isbot": "^5.1.31",
    "prisma": "^6.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.18.2"
  },
  "devDependencies": {
