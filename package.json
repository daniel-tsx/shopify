    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "eslint": "^9.39.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.26.0"
