# Reference configuration only. No Partner app is created by this repository.
client_id = "REPLACE_FOR_LIVE_USE"
name = "Merchant Operations"
application_url = "https://app.example.com"
embedded = true

[access_scopes]
scopes = "read_products,write_products,read_orders"

[auth]
redirect_urls = ["https://app.example.com/auth/callback"]

[webhooks]
api_version = "2026-07"

[[webhooks.subscriptions]]
topics = ["products/create", "products/update", "products/delete", "orders/create", "orders/updated", "app/uninstalled", "app/scopes_update"]
uri = "/webhooks"

[[webhooks.subscriptions]]
compliance_topics = ["customers/data_request", "customers/redact", "shop/redact"]
uri = "/webhooks"
